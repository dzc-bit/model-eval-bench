# ---- 运行时产物（可重建，不入库）----
sandboxes/*
!sandboxes/.gitkeep
packs/core/tools/_work/
packs/core/tools/_grade/
runs/_quarantine/
runs/blind/gates/*/
!runs/blind/gates/.gitkeep
runs/blind/calib/*/trial-*/workspace/
# harness 自检的临时工作区（conftest 固定放在评测台根内，跑完即弃）
.pytest-tmp/
.pytest-tmp-*/
# 浏览器验收的可重建日志、截图和快照
.playwright-cli/
output/playwright/
.harness-acceptance/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/
.tox/
.venv/
.venv-*/

# ---- 编辑器 / 操作系统 ----
.idea/
.vscode/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ---- 本地 agent 工具状态 ----
.zcode/

# ---- 密钥与凭据（本仓库不含，防止误提交）----
.env
.env.*
*.pem
*.key
credentials*.json
*secret*.json
*token*.json
# 模型档案的粘贴密钥（服务端本机密钥文件，绝不入库）
console/keys.local.json
# 本机配置（模型档案、密钥脱敏值、本机绝对路径都在里面）。
# 入库的只有 console/config.example.json 模板；首次启动会从模板自动生成。
console/config.json
# 本次会话跑题产出的评测记录（盲测校准数据单独保留，见上）
runs/DEMO-*/
runs/T1-*/
runs/T2-*/
runs/T3-*/
runs/T4-*/

# ---- 本次会话的开发残留（不是项目产物）----
# 一次性改样式脚本、锚解调试工作副本、工具评审记录、服务日志
_restyle.py
_work/
.impeccable/
.server-run.log
.server-run.err.log
.server-test.log
# 视觉审计的临时页面（本地生成，不入库）
console/static/_audit.html
