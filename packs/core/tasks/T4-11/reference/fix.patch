+
+// 最近成功时点只允许单调前进：部分成功、不可用与迟到的旧快照都不能让它回跳，
+// 也不能让它把一次"还没成功"的刷新冒充成成功。
+export function nextLastSuccessAt(
+  current: MarketRefreshMeta,
+  snapshot: RealtimeMarketSnapshot,
+  isPartial = false
+): string | null {
+  const previous = current.last_success_at ?? null;
+  if (isPartial || snapshot.status === "unavailable") {
+    return previous;
+  }
+  const candidate = snapshot.updated_at;
+  if (previous !== null && Date.parse(candidate) <= Date.parse(previous)) {
+    return previous;
+  }
+  return candidate;
 }
 
