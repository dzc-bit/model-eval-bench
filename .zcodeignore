# ---- 运行时产物（可重建，不入库）----
sandboxes/*
!sandboxes/.gitkeep
packs/core/tools/_work/
packs/core/tools/_grade/
runs/_quarantine/
runs/blind/gates/*/
!runs/blind/gates/.gitkeep
runs/blind/calib/*/trial-*/workspace/
# harness 自检的临时工作区（conftest 固定放在评测台根内，跑完即弃）
.pytest-tmp/
.pytest-tmp-*/
# 浏览器验收的可重建日志、截图和快照
.playwright-cli/
output/playwright/
.harness-acceptance/

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/
.tox/
.venv/
.venv-*/

# ---- 编辑器 / 操作系统 ----
.idea/
.vscode/
*.swp
*~
Thumbs.db
desktop.ini
.DS_Store

# ---- 本地 agent 工具状态 ----
.zcode/

# ---- 密钥与凭据（本仓库不含，防止误提交）----
.env
.env.*
*.pem
*.key
credentials*.json
*secret*.json
*token*.json
# 模型档案的粘贴密钥（服务端本机密钥文件，绝不入库）
console/keys.local.json

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
node_modules/
bower_components/
jspm_packages/
site-packages/
venv/
coverage/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
# ----- ↑ 以上为 ZCode 默认排除规则（自定义规则请写在本行下方，不会被同步/恢复改动）-----
# 自定义规则写在下方（本行提示可删除）
